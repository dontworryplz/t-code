[Desktop Entry]
Type=Application
Name=t-code
Comment=Three terminals in one window: files, editor tabs (micro + clangd) and a shell
Exec=@BIN@ %F
Icon=io.github.tcode
Terminal=false
Categories=Development;IDE;
MimeType=text/x-csrc;text/x-chdr;text/plain;inode/directory;
StartupWMClass=io.github.tcode
StartupNotify=true
SingleMainWindow=false
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=@BIN@ --new-window
