#!/bin/sh
# micro runs this for the system clipboard instead of wl-copy / wl-paste / xclip / xsel (t-code
# puts this folder first in micro's PATH): "micro-clip -i|-o clipboard|primary", -i taking the
# text to copy on stdin, -o writing the clipboard's text to stdout. micro also reads the clipboard
# once when it starts. Reading has a time limit: on GNOME, wl-paste can wait for keyboard focus
# forever, and micro waits with it, frozen (it neither draws nor quits).

action=copy
[ "$1" = -o ] && action=paste
register=$2

# micro reads the clipboard once right after it starts, only to see that it works, and when that
# read fails it writes an empty text instead. On GNOME every wl-paste / wl-copy shows up in the
# dock for a moment, t-code starts many editors at once, and the empty write cleared the user's
# clipboard and left a wl-copy running to own it. So a read in micro's first two seconds answers
# empty without asking the compositor, and an empty text is never copied.
if [ "$action" = paste ]; then
    age=$(ps -o etimes= -p "$PPID" 2>/dev/null)
    [ -n "$age" ] && [ "$age" -lt 2 ] && exit 0
else
    text=$(cat; echo x)
    text=${text%x}
    [ -z "$text" ] && exit 0
fi

if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-paste >/dev/null 2>&1; then
    if [ "$register" = primary ]; then
        set -- --primary
    else
        set --
    fi
    if [ "$action" = copy ]; then
        printf %s "$text" | exec wl-copy "$@"
    fi
    exec timeout 1 wl-paste --no-newline --type text "$@"
fi

if command -v xclip >/dev/null 2>&1; then
    selection=clipboard
    [ "$register" = primary ] && selection=primary
    if [ "$action" = copy ]; then
        printf %s "$text" | exec xclip -in -selection "$selection"
    fi
    exec timeout 1 xclip -out -selection "$selection"
fi

if command -v xsel >/dev/null 2>&1; then
    selection=--clipboard
    [ "$register" = primary ] && selection=--primary
    if [ "$action" = copy ]; then
        printf %s "$text" | exec xsel --input "$selection"
    fi
    exec timeout 1 xsel --output "$selection"
fi

echo "micro-clip: no wl-clipboard, xclip or xsel" >&2
exit 1
