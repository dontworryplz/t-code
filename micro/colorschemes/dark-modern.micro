# VS Code "Dark Modern" for micro.

# Code
color-link default "#CCCCCC,#1F1F1F"
color-link comment "#6A9955"
color-link todo "bold #6A9955"
color-link identifier "#9CDCFE"
color-link identifier.func "#DCDCAA"
color-link identifier.macro "#4FC1FF"
color-link type "#4EC9B0"
color-link type.keyword "#569CD6"
color-link statement "#C586C0"
color-link preproc "#C586C0"
color-link constant "#4FC1FF"
color-link constant.bool "#569CD6"
color-link constant.number "#B5CEA8"
color-link constant.string "#CE9178"
color-link constant.specialChar "#D7BA7D"
color-link constant.placeholder "#9CDCFE"
color-link symbol "#CCCCCC"
color-link special "#D7BA7D"
color-link underlined "underline #9CDCFE"
color-link error "#F14C4C"

# Editor UI
color-link line-number "#6E7681,#1F1F1F"
color-link current-line-number "#CCCCCC,#1F1F1F"
color-link cursor-line "#282828"
color-link color-column "#2B2B2B"
color-link indent-char "#404040"
color-link selection "#CCCCCC,#264F78"
color-link match-brace "#CCCCCC,#3A3D41"
color-link hlsearch "#CCCCCC,#623315"
color-link gutter-error "#F14C4C,#1F1F1F"
color-link gutter-warning "#CCA700,#1F1F1F"
color-link gutter-info "#3794FF,#1F1F1F"
color-link statusline "#CCCCCC,#181818"
color-link statusline.inactive "#9D9D9D,#181818"
color-link tabbar "#9D9D9D,#181818"
color-link tabbar.active "#FFFFFF,#1F1F1F"
color-link divider "#2B2B2B,#1F1F1F"
color-link scrollbar "#424242,#1F1F1F"
color-link message "#CCCCCC,#1F1F1F"
color-link error-message "#F14C4C,#1F1F1F"
color-link diff-added "#2EA043"
color-link diff-modified "#0078D4"
color-link diff-deleted "#F85149"
